<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="velardi_telegram_notification_form_view" model="ir.ui.view">
        <field name="name">velardi.telegram.notification.form</field>
        <field name="model">velardi.telegram.notification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="text" placeholder="Mensaje..."/>
                        </h1>
                    </div>
                    <group>
                     <group string="Update_id / Message_id ">
                            <field name="update_id" readonly="1"/>
                            <field name="message_id" readonly="1"/>
                        </group>
                        <group string="Origen (From)">
                            <field name="from_id" readonly="1"/>
                            <field name="from_first_name" readonly="1"/>
                            <field name="from_last_name" readonly="1"/>
                            <field name="from_username" readonly="1"/>
                            <field name="from_language_code" readonly="1"/>
                            <field name="from_is_bot" widget="boolean_toggle" readonly="1"/>
                        </group>
                        <group string="Destino (Chat)">
                            <field name="chat_id" readonly="1"/>
                            <field name="chat_first_name" readonly="1"/>
                            <field name="chat_last_name" readonly="1"/>
                            <field name="chat_username" readonly="1"/>
                            <field name="chat_type" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Detalles">
                            <field name="update_type" readonly="1"/>
                            <field name="notification_type" readonly="1"/>
                            <field name="date_notification" readonly="1"/>
                        </group>
                        <group string="Respuesta">
                            <field name="answered_chat_id" readonly="1"/>
                            <field name="notification_answered_option" readonly="1"/>
                            <field name="date_notification_answered_option" readonly="1"/>
                        </group>
                    </group>
                    <group string="Body">
                            <field name="notification_body_formatted" widget="text" readonly="1"/>
                            <field name="notification_body" widget="text" readonly="1"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="velardi_telegram_notification_list_view" model="ir.ui.view">
        <field name="name">velardi.telegram.notification.list</field>
        <field name="model">velardi.telegram.notification</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_notification"/>
                <field name="notification_type"/>
                <field name="from_id"/>
                <field name="from_first_name"/>
                <field name="from_username"/>
                <field name="chat_id"/>
                <field name="chat_first_name"/>
                <field name="chat_username"/>
                <field name="chat_type"/>
                <field name="update_type"/>
                <field name="text" widget="text"/>
                <field name="notification_answered_option"/>
                <field name="date_notification_answered_option"/>
                <field name="answered_chat_id"/>
                <field name="notification_body_formatted" invisible="1"/>
                <field name="notification_body" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="velardi_telegram_notification_search_view" model="ir.ui.view">
        <field name="name">velardi.telegram.notification.search</field>
        <field name="model">velardi.telegram.notification</field>
        <field name="arch" type="xml">
            <search>
                <field name="from_id"/>
                <field name="from_first_name"/>
                <field name="from_username"/>
                <field name="chat_id"/>
                <field name="chat_first_name"/>
                <field name="chat_username"/>
                <field name="text"/>
                <filter string="Simulación" name="simulation"
                        domain="[('from_is_bot', '=', True)]"/>
                <filter string="Reales" name="real"
                        domain="[('from_is_bot', '=', False)]"/>
                <filter string="Salientes" name="outgoing"
                        domain="[('notification_type', '=', 'outgoing')]"/>
                <filter string="Entrantes" name="incoming"
                        domain="[('notification_type', '=', 'incoming')]"/>
                <group expand="0" string="Agrupar">
                    <filter string="Fecha" name="group_date"
                            context="{'group_by': 'date_notification:month'}"/>
                    <filter string="Tipo" name="group_type"
                            context="{'group_by': 'notification_type'}"/>
                    <filter string="From Username" name="group_from"
                            context="{'group_by': 'from_username'}"/>
                    <filter string="Chat Username" name="group_chat"
                            context="{'group_by': 'chat_username'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="velardi_telegram_notification_action" model="ir.actions.act_window">
        <field name="name">Telegram Notifications</field>
        <field name="res_model">velardi.telegram.notification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="velardi_telegram_notification_search_view"/>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>

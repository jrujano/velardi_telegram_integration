<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="velardi_telegram_group_form_view" model="ir.ui.view">
        <field name="name">velardi.telegram.group.form</field>
        <field name="model">velardi.telegram.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" type="object"
                            string="Set to Draft"
                            invisible="state == 'draft'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="Are you sure you want to cancel this group?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_users" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <div class="o_stat_info">
                                <field name="user_count" class="o_stat_value"/>
                                <span class="o_stat_text">Users</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Group Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Telegram">
                            <field name="chat_id"/>
                            <field name="bot_config_id"/>
                        </group>
                        <group string="Details">
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Describe this group..."/>
                    </group>
                    <notebook>
                        <page string="Users" name="users">
                            <field name="user_ids">
                                <list editable="bottom" decoration-success="active == True" decoration-muted="active == False">
                                    <field name="first_name"/>
                                    <field name="last_name"/>
                                    <field name="telegram_username"/>
                                    <field name="chat_id"/>
                                    <field name="email"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'registered'"
                                           decoration-warning="state == 'awaiting_email'"
                                           decoration-danger="state == 'new'"
                                           decoration-info="state == 'idle'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="velardi_telegram_group_list_view" model="ir.ui.view">
        <field name="name">velardi.telegram.group.list</field>
        <field name="model">velardi.telegram.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="chat_id"/>
                <field name="bot_config_id"/>
                <field name="user_count" string="Users"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="velardi_telegram_group_search_view" model="ir.ui.view">
        <field name="name">velardi.telegram.group.search</field>
        <field name="model">velardi.telegram.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="chat_id"/>
                <field name="bot_config_id"/>
                <filter string="Active" name="active"
                        domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive"
                        domain="[('active', '=', False)]"/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Active State" name="active_state"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Cancelled" name="cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Bot" name="group_config"
                            context="{'group_by': 'bot_config_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="velardi_telegram_group_action" model="ir.actions.act_window">
        <field name="name">Telegram Groups</field>
        <field name="res_model">velardi.telegram.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="velardi_telegram_group_search_view"/>
    </record>

</odoo>
